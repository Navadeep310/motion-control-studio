# Ollama vision model used only to describe the character/reference and draft a prompt.
OLLAMA_URL=http://localhost:11434
VISION_MODEL=qwen2.5vl
VISION_TIMEOUT_SECONDS=600

# Local ComfyUI server. Full mode submits a workflow to this server.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_INPUT_DIR=C:\ComfyUI\input
WORKFLOW_PATH=workflows/wan_animate_api.json
COMFY_TIMEOUT_SECONDS=600

# Replace these example IDs/input keys with the values from YOUR API-format workflow.
IMAGE_NODE_ID=10
VIDEO_NODE_ID=11
PROMPT_NODE_ID=12
IMAGE_INPUT_NAME=image
VIDEO_INPUT_NAME=video
PROMPT_INPUT_NAME=text
# Optional: set both values only if your workflow has a matching orientation control node.
ORIENTATION_NODE_ID=
ORIENTATION_INPUT_NAME=orientation

DATA_DIR=data
